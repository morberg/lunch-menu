{
  "name": "lunch-menu-scraper",
  "version": "1.0.0",
  "description": "A web scraper for extracting daily lunch menus from restaurants in Lund.",
  "main": "dist/web/server.js",
  "scripts": {
    "start": "npm run build && node dist/web/server.js",
    "dev": "tsx watch src/web/server.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/web/views dist/web/",
    "vercel-build": "npm run build",
    "test": "jest",
    "lint": "tsc --project tsconfig.check.json",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.0.0-rc.3",
    "express": "^4.17.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "domhandler": "^5.0.3",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "author": "",
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}